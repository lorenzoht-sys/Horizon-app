VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé publique VAPID (rappels-patients — notifications push).
# Générée avec `npx web-push generate-vapid-keys` (voir RAPPORT_RAPPELS.md).
# Cette clé est publique par nature (envoyée au navigateur), mais doit rester
# identique à VAPID_PRIVATE_KEY ci-dessous (même paire de clés).
VITE_VAPID_PUBLIC_KEY=...

# Variables serveur uniquement (NE JAMAIS préfixer par VITE_, sinon elles
# seraient envoyées au navigateur). À configurer dans Vercel > Settings >
# Environment Variables, jamais commitées avec une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
PATIENT_SESSION_SECRET=une-longue-chaine-aleatoire-secrete
ANTHROPIC_API_KEY=sk-ant-...

# Rappels patients — notifications push (voir RAPPORT_RAPPELS.md).
# VAPID_PRIVATE_KEY : clé privée générée avec `npx web-push generate-vapid-keys`
#   (doit correspondre à VITE_VAPID_PUBLIC_KEY ci-dessus).
# VAPID_CONTACT_EMAIL : email de contact transmis aux services de push (format mailto:).
# CRON_SECRET : chaîne aléatoire longue, vérifiée sur l'en-tête x-cron-secret
#   de /api/cron/rappels (appelé par le job pg_cron de Supabase).
VAPID_PRIVATE_KEY=...
VAPID_CONTACT_EMAIL=mailto:contact@example.com
CRON_SECRET=une-longue-chaine-aleatoire-secrete

# Sentry (optionnel, voir docs/SENTRY.md) — à configurer UNIQUEMENT dans
# l'environnement Production de Vercel. Si ces variables sont absentes,
# Sentry est désactivé (dev local, Preview/staging inclus).
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
