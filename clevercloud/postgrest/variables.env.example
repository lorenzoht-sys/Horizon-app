# Variables de l'application PostgREST sur Clever Cloud (valeurs FICTIVES).
# Les secrets se saisissent dans la console Clever Cloud, jamais ici.

# Adresse fournie par l'add-on PostgreSQL (POSTGRESQL_ADDON_URI), en TLS.
PGRST_DB_URI=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?sslmode=require
PGRST_DB_SCHEMAS=public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_ANON_ROLE=anon
# Pool borné : le plan PostgreSQL limite le nombre de connexions, à partager
# avec l'application (routes api/).
PGRST_DB_POOL=10
# Même plafond que Supabase (1 000 lignes par requête) : le front a été écrit
# avec cette limite.
PGRST_DB_MAX_ROWS=1000
# Pas de description publique du schéma.
PGRST_OPENAPI_MODE=disabled

# Jetons Keycloak (realm Horizon, client « horizon-praticien ») :
# - PGRST_JWT_SECRET = le JSON des clés publiques du realm (JWKS, endpoint
#   …/realms/horizon/protocol/openid-connect/certs), à mettre à jour à chaque
#   rotation de clés ;
# - le jeton doit porter "role": "authenticated" (mapper « hardcoded claim »)
#   et "aud": "horizon-praticien" ;
# - le "sub" Keycloak = l'UUID historique du praticien (import avec id conservé).
PGRST_JWT_SECRET={"keys":[]}
PGRST_JWT_AUD=horizon-praticien
PGRST_JWT_ROLE_CLAIM_KEY=.role
